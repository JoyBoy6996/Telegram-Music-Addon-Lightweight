# Telegram Music Addon (Go) - Environment Configuration
# Copy this file to .env and fill in your values, or run:
#   ./telegram-music-addon login

# Telegram API Credentials (Required)
# Get your API ID and Hash from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Generated automatically by `./telegram-music-addon login`
# Compatible with both gotd and GramJS/Telethon StringSession format (starting with '1')
TELEGRAM_SESSION_STRING=

# Music channel numeric ID (e.g. -1001234567890) or channel username / title:
TELEGRAM_CHANNEL=

# Server & Network (Optional)
# Server port (default: 3000)
PORT=3000

# Secret path protection token (e.g. URL_SECRET=mysecret creates /mysecret/manifest.json)
# If left blank, all endpoints are directly accessible at root.
URL_SECRET=

# Public base URL (Optional, useful when behind reverse proxy, e.g. https://music.example.com)
PUBLIC_URL=

